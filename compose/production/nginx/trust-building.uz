# Catch-all server block to drop requests with unrecognized Host headers (bot scanners)
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

# HTTP bootstrap site. Certbot --nginx adds TLS and the HTTPS redirect in place.
# Install as /etc/nginx/sites-available/trust-building.uz on the host.
upstream trustbuilding {
    server 127.0.0.1:8010;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name trust-building.uz;

    access_log /var/log/nginx/trust-building.uz.access.log;
    error_log /var/log/nginx/trust-building.uz.error.log;
    client_max_body_size 100M;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location ~ /\. {
        deny all;
    }

    location /static/ {
        alias /var/www/trustbuilding/static/;
        expires 7d;
        access_log off;
        autoindex off;
    }

    location /media/ {
        alias /var/www/trustbuilding/media/;
        autoindex off;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass http://trustbuilding;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
