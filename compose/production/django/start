#!/bin/bash
set -euo pipefail

: "${ADMIN_PHONE:?Set ADMIN_PHONE in env/.production}"
: "${ADMIN_PASSWORD:?Set ADMIN_PASSWORD in env/.production}"

echo "Running database migrations..."
python manage.py migrate --noinput

echo "Creating the shared cache table..."
python manage.py createcachetable

echo "Creating the initial administrator if none exists..."
python manage.py createsuperuserifnone

echo "Collecting prebuilt static files..."
python manage.py collectstatic --noinput

echo "Starting Gunicorn..."
exec gunicorn application.wsgi:application \
    --bind 0.0.0.0:8000 \
    --workers "${GUNICORN_WORKERS:-3}" \
    --worker-class gthread \
    --threads "${GUNICORN_THREADS:-2}" \
    --worker-tmp-dir /dev/shm \
    --max-requests 1000 \
    --max-requests-jitter 100 \
    --timeout "${GUNICORN_TIMEOUT:-120}" \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile -
