#!/bin/bash
set -euo pipefail

# Read credentials as data; quotes and dollar signs must never become Python code.
python <<'PY'
import os
import sys
import time

import psycopg2

deadline = time.monotonic() + int(os.getenv('POSTGRES_WAIT_TIMEOUT', '60'))
while True:
    try:
        connection = psycopg2.connect(
            dbname=os.environ['POSTGRES_DB'],
            user=os.environ['POSTGRES_USER'],
            password=os.environ['POSTGRES_PASSWORD'],
            host=os.environ['POSTGRES_HOST'],
            port=os.getenv('POSTGRES_PORT', '5432'),
            connect_timeout=5,
        )
        connection.close()
        break
    except psycopg2.OperationalError:
        if time.monotonic() >= deadline:
            sys.exit('PostgreSQL did not become available before the startup deadline.')
        print('Waiting for PostgreSQL...', flush=True)
        time.sleep(2)
print('PostgreSQL is available', flush=True)
PY

exec "$@"
