#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

echo "Running database migrations..."
python manage.py migrate --settings=application.settings.production

echo "Creating cache table if it doesn't exist..."
python manage.py createcachetable --settings=application.settings.production

echo "Creating superuser if none exists..."
python manage.py createsuperuserifnone --settings=application.settings.production

echo "Compiling translation messages..."
if [ -d "locale" ] && [ -n "$(find locale -name '*.po' 2>/dev/null)" ]; then
    python manage.py compilemessages --settings=application.settings.production
    echo "✅ Translations compiled successfully"
else
    echo "⚠️  No translation files found, skipping compilemessages"
fi

echo "Installing Tailwind dependencies..."
if [ -d "theme/static_src" ]; then
    cd theme/static_src
    if [ -f "package.json" ]; then
        npm install
        cd /app
        echo "✅ Tailwind dependencies installed"
    else
        cd /app
        echo "⚠️  No package.json found in theme/static_src"
    fi
else
    echo "⚠️  Theme app not initialized yet"
fi

echo "Building Tailwind CSS..."
python manage.py tailwind build || echo "⚠️  Tailwind build skipped"

echo "Collecting static files..."
python manage.py collectstatic --noinput --settings=application.settings.production

echo "Starting Gunicorn server (staging — reduced resources)..."
exec gunicorn application.wsgi:application \
    --bind 0.0.0.0:8000 \
    --workers 2 \
    --worker-class gthread \
    --threads 2 \
    --worker-tmp-dir /dev/shm \
    --max-requests 500 \
    --max-requests-jitter 50 \
    --timeout 120 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile - \
    --env DJANGO_SETTINGS_MODULE=application.settings.production
